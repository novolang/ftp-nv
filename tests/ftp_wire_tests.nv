// ftp_wire_tests.nv — the lines of FTP's control connection, one at a time.
//
// THE VECTORS come from RFC 959, RFC 2428, RFC 2389 and RFC 3659, and the
// expected values are the ones those documents print, worked out in the
// comment above each case.  Reply texts that the RFCs do not give are the
// ones vsftpd 3.0 and ProFTPD 1.3 write.

use std.bytes
use std.str
use std.test
use ftpwire

fn reply_error(line: Str) -> Str
    match ftpwire.parse_reply_line(line)
        Ok(_)  => "ok"
        Err(e) => e.message()

@test
fn test_numbers() [io]
    test.case("digits")
    test.assert_eq(ftpwire.parse_number("0"), 0)
    test.assert_eq(ftpwire.parse_number("1048576"), 1048576)
    test.assert_eq(ftpwire.parse_number("999999999999999"), 999999999999999)
    test.case("anything else is -1")
    test.assert_eq(ftpwire.parse_number(""), -1)
    test.assert_eq(ftpwire.parse_number("-1"), -1)
    test.assert_eq(ftpwire.parse_number("+1"), -1)
    test.assert_eq(ftpwire.parse_number("1 "), -1)
    test.assert_eq(ftpwire.parse_number("1000000000000000"), -1)

@test
fn test_reply_lines_of_rfc_959_section_4_2() [io]
    // "123 text" is a whole reply, "123-text" opens a multi-line one.
    test.case("a reply line")
    match ftpwire.parse_reply_line("220 (vsFTPd 3.0.3)")
        Ok(r)  =>
            test.assert_eq(r.code, 220)
            test.assert(r.last)
            test.assert_eq(r.text, "(vsFTPd 3.0.3)")
        Err(e) => test.assert_eq(e.message(), "")
    test.case("the first line of a multi-line reply")
    match ftpwire.parse_reply_line("211-Features:")
        Ok(r)  =>
            test.assert_eq(r.code, 211)
            test.assert(not r.last)
            test.assert_eq(r.text, "Features:")
        Err(e) => test.assert_eq(e.message(), "")
    test.case("a code alone is a whole reply with no text")
    match ftpwire.parse_reply_line("200")
        Ok(r)  =>
            test.assert(r.last)
            test.assert_eq(r.text, "")
        Err(e) => test.assert_eq(e.message(), "")
    test.case("lines that are not replies")
    for bad in ["", "22", "abc def", "099 low", "600 high", "220x", "22a text", "- 220"]
        test.assert_eq(reply_error(bad), "the line \"" + bad + "\" is not an FTP reply")

@test
fn test_the_end_of_a_multi_line_reply() [io]
    // RFC 959 section 4.2: the last line begins with the same code and a
    // space; lines between may begin with anything.
    test.case("the same code and a space ends it")
    test.assert(ftpwire.ends_reply(211, "211 End"))
    test.assert(ftpwire.ends_reply(211, "211"))
    test.case("a hyphen, another code or free text does not")
    test.assert(not ftpwire.ends_reply(211, "211-End"))
    test.assert(not ftpwire.ends_reply(211, "212 End"))
    test.assert(not ftpwire.ends_reply(211, " 211 End"))
    test.assert(not ftpwire.ends_reply(211, "2110"))
    test.case("the class is the first digit")
    test.assert_eq(ftpwire.reply_class(150), 1)
    test.assert_eq(ftpwire.reply_class(550), 5)

fn command_text(verb: Str, arg: Str) -> Str
    match ftpwire.encode_command(verb, arg)
        Ok(x)  => bytes.byte_list_to_str(x)
        Err(e) => e.message()

@test
fn test_commands() [io]
    test.case("a keyword alone and with an argument")
    test.assert_eq(command_text("PASV", ""), "PASV\r\n")
    test.assert_eq(command_text("RETR", "a b.txt"), "RETR a b.txt\r\n")
    test.case("an argument with CR, LF, NUL or 0xFF is refused")
    let refusal = "the argument of RETR is empty or holds a CR, an LF, a NUL or 0xFF"
    test.assert_eq(command_text("RETR", "a\rb"), refusal)
    test.assert_eq(command_text("RETR", "a\nb"), refusal)
    test.assert_eq(command_text("RETR", "a" + str.from_byte(0)), refusal)
    test.assert_eq(command_text("RETR", "a" + str.from_byte(255)), refusal)
    test.case("a line of 4096 octets is built and 4097 are refused")
    test.assert_eq(str.len(command_text("STOR", str.repeat("x", 4096 - 7))), 4096)
    test.assert_eq(command_text("STOR", str.repeat("x", 4096 - 6)), "a command of 4097 octets is over 4096")

fn passive_text(text: Str) -> Str
    match ftpwire.parse_passive(text)
        Ok(a)  => a.host + ":" + str.from_int(a.port)
        Err(e) => e.message()

@test
fn test_passive_replies_of_rfc_959_section_4_1_2() [io]
    // 19 * 256 + 137 = 5001.
    test.case("the six numbers in parentheses, as the RFC writes them")
    test.assert_eq(passive_text("Entering Passive Mode (192,168,0,1,19,137)."), "192.168.0.1:5001")
    test.assert_eq(passive_text("Entering Passive Mode (127,0,0,1,193,115)."), "127.0.0.1:49523")
    test.case("spaces inside the parentheses")
    test.assert_eq(passive_text("Entering Passive Mode (10, 0, 0, 1, 4, 1)"), "10.0.0.1:1025")
    test.case("an unclosed parenthesis")
    test.assert_eq(passive_text("Entering Passive Mode (10,0,0,1,4,1"), "10.0.0.1:1025")
    test.case("no parentheses, as some servers write it")
    test.assert_eq(passive_text("Entering Passive Mode 10,0,0,1,4,1"), "10.0.0.1:1025")
    test.case("five numbers, a number over 255, a word and port 0")
    for bad in ["Entering Passive Mode (1,2,3,4,5)", "Entering Passive Mode (1,2,3,4,5,300)",
                "Entering Passive Mode (a,b,c,d,e,f)", "Entering Passive Mode (1,2,3,4,0,0)", "no numbers here"]
        test.assert_eq(passive_text(bad), "\"" + bad + "\" holds no host and port for passive mode")

fn extended_text(text: Str) -> Str
    match ftpwire.parse_extended_passive(text)
        Ok(p)  => str.from_int(p)
        Err(e) => e.message()

@test
fn test_extended_passive_replies_of_rfc_2428_section_3() [io]
    // RFC 2428 section 3: "229 Entering Extended Passive Mode (|||6446|)".
    test.case("the example of the RFC")
    test.assert_eq(extended_text("Entering Extended Passive Mode (|||6446|)"), "6446")
    test.case("another delimiter")
    test.assert_eq(extended_text("Entering Extended Passive Mode (!!!2121!)"), "2121")
    test.case("malformed texts")
    for bad in ["Entering Extended Passive Mode", "(|||6446|", "(|||0|)", "(|||70000|)", "(|||x|)", "(||6446|)",
                "(|1|2|6446|)", "( ||6446|)", "(|||6446|)extra|"]
        let want = if bad == "(|||6446|)extra|"
            "6446"
        else
            "\"" + bad + "\" is not an extended passive port"
        test.assert_eq(extended_text(bad), want)

fn port_text(host: Str, port: Int) -> Str
    match ftpwire.port_argument(host, port)
        Ok(a)  => a
        Err(e) => e.message()

fn eprt_text(protocol: Int, host: Str, port: Int) -> Str
    match ftpwire.eprt_argument(protocol, host, port)
        Ok(a)  => a
        Err(e) => e.message()

@test
fn test_active_mode_arguments() [io]
    // 5001 = 19 * 256 + 137.
    test.case("PORT")
    test.assert_eq(port_text("192.168.0.1", 5001), "192,168,0,1,19,137")
    test.assert_eq(port_text("1.2.3.4", 1), "1,2,3,4,0,1")
    test.assert_eq(port_text("1.2.3.4", 0), "0 is not a valid offset, port or protocol number")
    test.assert_eq(port_text("1.2.3.4", 65536), "65536 is not a valid offset, port or protocol number")
    test.assert_eq(port_text("1.2.3", 80), "\"1.2.3\" is not a usable host address")
    test.assert_eq(port_text("1,2,3,4", 80), "\"1,2,3,4\" is not a usable host address")
    test.assert_eq(port_text("1.2.3.999", 80), "\"1.2.3.999\" is not a usable host address")

    // RFC 2428 section 2 gives |1|132.235.1.2|6275| and
    // |2|1080::8:800:200C:417A|5282|.
    test.case("EPRT, the two examples of the RFC")
    test.assert_eq(eprt_text(1, "132.235.1.2", 6275), "|1|132.235.1.2|6275|")
    test.assert_eq(eprt_text(2, "1080::8:800:200C:417A", 5282), "|2|1080::8:800:200C:417A|5282|")
    test.case("EPRT refusals")
    test.assert_eq(eprt_text(3, "1.2.3.4", 80), "3 is not a valid offset, port or protocol number")
    test.assert_eq(eprt_text(1, "1.2.3.4", 0), "0 is not a valid offset, port or protocol number")
    test.assert_eq(eprt_text(1, "", 80), "\"\" is not a usable host address")
    test.assert_eq(eprt_text(2, "a|b", 80), "\"a|b\" is not a usable host address")
    test.assert_eq(eprt_text(2, "a\rb", 80), "\"a\rb\" is not a usable host address")
    test.assert_eq(eprt_text(1, "not.an.address", 80), "\"not.an.address\" is not a usable host address")

fn path_text(text: Str) -> Str
    match ftpwire.parse_quoted_path(text)
        Ok(p)  => p
        Err(e) => e.message()

@test
fn test_quoted_paths_of_rfc_959_section_5() [io]
    test.case("a path and its explanation")
    test.assert_eq(path_text("\"/home/user\" is the current directory"), "/home/user")
    test.case("a doubled quote is one quote")
    test.assert_eq(path_text("\"/a \"\"b\"\" c\" created"), "/a \"b\" c")
    test.case("an empty path")
    test.assert_eq(path_text("\"\" is empty"), "")
    test.case("no opening quote, and no closing one")
    test.assert_eq(path_text("/home/user"), "\"/home/user\" does not begin with a quoted path")
    test.assert_eq(path_text("\"/home/user"), "\"\"/home/user\" does not begin with a quoted path")

@test
fn test_size_and_mdtm_of_rfc_3659() [io]
    test.case("a size")
    match ftpwire.parse_size("1048576")
        Ok(n)  => test.assert_eq(n, 1048576)
        Err(e) => test.assert_eq(e.message(), "")
    match ftpwire.parse_size(" 12 ")
        Ok(n)  => test.assert_eq(n, 12)
        Err(e) => test.assert_eq(e.message(), "")
    match ftpwire.parse_size("big")
        Ok(_)  => test.assert_eq("ok", "refused")
        Err(e) => test.assert_eq(e.message(), "\"big\" is not a size")

    // RFC 3659 section 2.3: "19980615100045.014" is 1998-06-15 10:00:45
    // and 14 thousandths of a second UTC.
    test.case("a time with a fraction, the RFC's example")
    match ftpwire.parse_mdtm("19980615100045.014")
        Ok(t)  =>
            test.assert_eq(t.year, 1998)
            test.assert_eq(t.month, 6)
            test.assert_eq(t.day, 15)
            test.assert_eq(t.hour, 10)
            test.assert_eq(t.minute, 0)
            test.assert_eq(t.second, 45)
            test.assert_eq(t.fraction, "014")
        Err(e) => test.assert_eq(e.message(), "")
    test.case("a time without one, and a leap second")
    match ftpwire.parse_mdtm("20161231235960")
        Ok(t)  =>
            test.assert_eq(t.second, 60)
            test.assert_eq(t.fraction, "")
        Err(e) => test.assert_eq(e.message(), "")
    test.case("times that are not")
    for bad in ["", "1998", "199806151000450", "19980615100045.", "19980615100045.x", "19981315100045",
                "19980015100045", "19980615100045x", "19980632100045", "19980600100045", "19980615240045",
                "19980615106045", "19980615100061", "abcdefghijklmn"]
        match ftpwire.parse_mdtm(bad)
            Ok(_)  => test.assert_eq(bad, "refused")
            Err(e) => test.assert_eq(e.message(), "\"" + bad + "\" is not a modification time")

@test
fn test_features_of_rfc_2389_section_3_2() [io]
    // RFC 2389 section 3.2 prints a FEAT reply of this shape.
    let lines = ["Extensions supported:", " MLST size*;type;perm;", " SIZE", " COMPRESSION", " MDTM", "END"]
    test.case("the lines between the first and the last")
    let f = ftpwire.parse_features(lines)
    test.assert_eq(str.join(f, "|"), "MLST size*;type;perm;|SIZE|COMPRESSION|MDTM")
    test.case("a reply of one or two lines lists nothing")
    test.assert_eq(list.len(ftpwire.parse_features(["No features"])), 0)
    test.assert_eq(list.len(ftpwire.parse_features(["Features:", "End"])), 0)
    test.case("a feature is found by its first word, without regard to case")
    test.assert(ftpwire.has_feature(f, "mlst"))
    test.assert(ftpwire.has_feature(f, "SIZE"))
    test.assert(not ftpwire.has_feature(f, "UTF8"))
    test.assert(not ftpwire.has_feature(["", "UTF8"], "x"))
    test.case("the arguments of a feature")
    test.assert_eq(ftpwire.feature_arg(f, "MLST"), "size*;type;perm;")
    test.assert_eq(ftpwire.feature_arg(f, "SIZE"), "")
    test.assert_eq(ftpwire.feature_arg(f, "UTF8"), "")
